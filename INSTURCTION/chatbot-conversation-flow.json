{
  "version": "2.1",
  "conversation_config": {
    "language": "ko",
    "max_retry_attempts": 2,
    "timeout_seconds": 300,
    "personalization": {
      "greeting_style": "professional",
      "use_honorifics": true
    }
  },
  "flow_states": {
    "START": {
      "message": "안녕하세요. 알레르기 검사 결과를 확인하고 실제 증상 경험을 기록하는 것을 도와드리겠습니다.",
      "next": "SHOW_POSITIVES"
    },
    "SHOW_POSITIVES": {
      "action": "extract_positive_allergens",
      "message_template": "검사에서 양성으로 나온 항목은 다음과 같습니다:\n{allergen_list}\n\n이 중에서 실제로 노출되었을 때 증상(재채기, 콧물, 가려움 등)이 있었던 번호를 모두 선택해 주세요.",
      "input_type": "multiple_choice",
      "validation": "numeric_list",
      "next": "CLASSIFY_REMAINING"
    },
    "CLASSIFY_REMAINING": {
      "message_template": "감사합니다. 이제 나머지 {count}개 항목에 대해 알려주세요:\n{remaining_list}\n\n각 항목별로:\nA) 노출되었지만 증상이 없었음\nB) 아직 노출된 적이 없음\n\n예시: '1-A, 2-B, 3-A'",
      "input_type": "classification",
      "validation": "classification_format",
      "next": "CONFIRM_RESULTS"
    },
    "CONFIRM_RESULTS": {
      "message_template": "다음과 같이 기록하겠습니다:\n\n✅ 증상 있음: {symptomatic}\n⭕ 증상 없음: {asymptomatic}\n❓ 노출 경험 없음: {unknown}\n\n맞으신가요? (예/아니오)",
      "input_type": "confirmation",
      "on_yes": "GENERATE_JSON",
      "on_no": "SHOW_POSITIVES"
    },
    "GENERATE_JSON": {
      "action": "create_final_json",
      "message": "기록이 완료되었습니다. 감사합니다!",
      "next": "END"
    }
  },
  "validation_rules": {
    "numeric_list": {
      "pattern": "^[0-9,\\s]+$",
      "error_message": "숫자와 쉼표만 입력해주세요. 예: 1, 3, 5"
    },
    "classification_format": {
      "pattern": "^([0-9]+-[AB],?\\s*)+$",
      "error_message": "형식이 올바르지 않습니다. 예: 1-A, 2-B"
    }
  },
  "error_handling": {
    "invalid_input": {
      "message": "입력 형식이 올바르지 않습니다. 다시 입력해주세요.",
      "action": "retry_current_state"
    },
    "timeout": {
      "message": "시간이 초과되었습니다. 처음부터 다시 시작하시겠습니까?",
      "action": "restart_or_exit"
    }
  },
  "output_schema": {
    "patient_id": "string",
    "test_date": "YYYY-MM-DD",
    "conversation_metadata": {
      "session_id": "uuid",
      "duration_seconds": "integer",
      "completion_status": "complete|incomplete"
    },
    "exposure_feedback": {
      "symptomatic": ["allergen_names"],
      "asymptomatic": ["allergen_names"],
      "unknown_exposure": ["allergen_names"],
      "confidence_scores": {
        "allergen_name": "float(0-1)"
      }
    }
  }
}