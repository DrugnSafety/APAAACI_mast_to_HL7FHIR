<style>
:root{--ink:#183348;--muted:#526d80;--blue:#145d89;--pale:#eaf5fc;--line:#cbdde9;--bg:#f3f7fa;--warn:#fff3d7}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.65 -apple-system,BlinkMacSystemFont,'Apple SD Gothic Neo','Malgun Gothic',sans-serif}a{color:var(--blue);text-underline-offset:3px;overflow-wrap:anywhere}button,input,textarea{font:inherit}button,.button{display:inline-flex;justify-content:center;align-items:center;min-height:46px;border:1px solid var(--line);border-radius:10px;background:white;color:var(--blue);padding:10px 18px;text-decoration:none;cursor:pointer}button.primary{background:var(--blue);color:white;border-color:var(--blue)}button:hover,.button:hover{filter:brightness(.96)}button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #cf8d26;outline-offset:3px}h1{font-size:clamp(27px,4vw,37px);line-height:1.4;margin:10px 0 16px}h2{font-size:24px;line-height:1.5;margin:0 0 16px}p{margin:10px 0}main{max-width:850px;margin:24px auto 50px;padding:0 22px}.top{max-width:1000px;margin:auto;padding:18px 22px;display:flex;gap:12px 24px;justify-content:space-between;flex-wrap:wrap;font-size:14px}.brand{font-weight:750;letter-spacing:.03em}.preview{background:var(--warn);border-bottom:1px solid #e1c68d;padding:12px 22px;font-size:14px;text-align:center}.hero small{color:var(--blue);font-weight:750}.lead{color:var(--muted)}.panel{background:#fff;border:1px solid var(--line);border-radius:16px;padding:28px;margin:20px 0}.help{color:var(--muted);font-size:15px}.note{background:var(--pale);padding:16px 19px;border-radius:10px}.progress{display:flex;gap:8px;list-style:none;padding:0;margin:24px 0;font-size:13px}.progress li{flex:1;padding:9px 5px;border-bottom:4px solid var(--line);color:var(--muted)}.progress li[aria-current=step]{border-color:var(--blue);color:var(--blue);font-weight:750}fieldset{border:0;padding:0;margin:24px 0}legend{font-size:19px;font-weight:750;line-height:1.5;max-width:100%;padding:0;margin-bottom:13px}.choices{display:flex;flex-wrap:wrap;gap:9px}.choice{display:flex;gap:9px;align-items:center;min-height:48px;padding:10px 14px;border:1px solid var(--line);border-radius:9px;cursor:pointer;background:#fff;font-size:16px}.choice:has(input:checked){border-color:var(--blue);background:var(--pale);box-shadow:0 0 0 1px var(--blue)}input[type=radio]{width:18px;height:18px;flex:none;margin:0;accent-color:var(--blue)}.ratings{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}.ratings .choice{display:flex;flex-direction:column;justify-content:center;text-align:center;padding:10px 5px;line-height:1.4;font-size:14px;min-height:100px}.ratings input{align-self:center}.ratings b{font-size:20px}.other-choices{display:flex;flex-wrap:wrap;gap:9px;margin-top:9px}.item{border-bottom:1px solid var(--line);padding-bottom:25px}.item:last-of-type{border-bottom:0}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}.actions .primary{margin-left:auto}textarea{width:100%;min-height:110px;resize:vertical;border:1px solid #a9c4d7;border-radius:9px;padding:12px;color:var(--ink);background:white}.counter{text-align:right;font-size:13px;color:var(--muted)}.error{color:#a82828;font-size:15px;font-weight:650}.summary{margin:0}.summary dt{font-size:14px;color:var(--muted);margin:18px 0 4px}.summary dd{margin:0;overflow-wrap:anywhere;white-space:pre-wrap}.summary .answer{padding:9px 12px;background:#f1f6fa;border-radius:7px}.status{background:#eaf5ee;border:1px solid #b9d6c3;padding:20px;border-radius:12px}.status h2{color:#28563c}details{font-size:14px;margin:22px 0}summary{cursor:pointer;color:var(--blue);padding:9px 0}footer{max-width:850px;margin:auto;padding:15px 22px 30px;color:var(--muted);font-size:13px}footer a{margin-right:14px}[hidden]{display:none!important}.print-only{display:none}.paper table{width:100%;border-collapse:collapse}.paper td,.paper th{border:1px solid #aab9c5;padding:7px;text-align:center}.paper td:nth-child(2){text-align:left}.paper h1{font-size:19pt}.paper h2{font-size:12pt;margin-top:13px}.paper p{margin:6px 0}
@media(max-width:540px){main{padding:0 14px;margin-top:18px}.panel{padding:21px 16px}.ratings{grid-template-columns:repeat(5,minmax(0,1fr));gap:5px}.ratings .choice{font-size:12px;padding:9px 3px;min-height:114px}.choice{font-size:15px}.progress{font-size:12px}.top{padding:15px}.actions button{flex:1;padding:10px 12px}.actions .primary{margin-left:0}.other-choices .choice{flex:1;min-width:120px}.preview{text-align:left;padding:12px 15px}}
@media(prefers-reduced-motion:no-preference){.panel{animation:appear .2s ease-out}@keyframes appear{from{opacity:.7;transform:translateY(5px)}to{opacity:1;transform:none}}}
@media print{@page{size:A4;margin:15mm}body{background:white;font-size:10pt;line-height:1.5}.screen-only,main,body>header,body>footer{display:none!important}.print-only{display:block!important}.paper{margin:0;padding:0}.paper table{font-size:9pt}.paper th{background:#eaf3fa}tr{break-inside:avoid}h1,h2{break-after:avoid}a{color:inherit;text-decoration:none}}
</style>
